# Public browser values. Safe to expose in a Vite build, but never commit service_role keys.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# 1v1 duels use Supabase Realtime broadcast + presence (no tables needed).
# Enable Realtime for the project; without it duels fall back to a CPU rival.

# Edge Function secrets configured in Supabase, not in GitHub Pages:
# OPENAI_API_KEY=...
# OPENAI_MODEL=gpt-4o-mini
